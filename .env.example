# CortexCrawler environment template.
# Copy to `.env` and fill in. NEVER put real secrets in THIS file — it is committed.
# Put real values in `.env` (gitignored). These are read by boto3 + cortexcrawler config.

# --- AWS credentials (boto3 standard chain) ---
# Prefer an IAM role on AWS compute and leave these blank. Use keys only locally.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Turn on the AWS backends (default is local; these flip to Bedrock + S3 Vectors) ---
CORTEX_EMBEDDER_BACKEND=bedrock      # local | bedrock
CORTEX_STORE_BACKEND=s3vectors       # local | s3vectors
CORTEX_ANSWER_BACKEND=bedrock        # local | bedrock

# --- S3 Vectors target ---
CORTEX_VECTOR_BUCKET=your-s3-vector-bucket
CORTEX_VECTOR_INDEX=cortex-kb

# --- Optional: serve images from S3/CloudFront instead of relative paths ---
CORTEX_IMAGE_BASE_URL=https://your-cloudfront-domain.net

# --- Optional: logging ---
CORTEX_LOG_LEVEL=INFO
